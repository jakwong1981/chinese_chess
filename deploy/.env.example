# 3D Xiangqi — environment template. Copy to deploy/.env and fill in real values.
#   cp deploy/.env.example deploy/.env

# Host port that maps to the backend container's 8080.
BACKEND_PORT=8080

# PostgreSQL credentials (used by the future Spring backend).
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=xiangqi

# Redis password (used by the future Spring backend).
REDIS_PASSWORD=change-me-redis

# Public domain for TLS (used by deploy.sh + nginx).
DOMAIN=example.com

# Contact email for Let's Encrypt / Certbot.
CERTBOT_EMAIL=admin@example.com
