# 3D Xiangqi — environment template. Copy to deploy/.env and fill in real values.
#   cp deploy/.env.example deploy/.env

# Host ports (loopback-only) mapping to the backend containers' 8080.
# Public traffic arrives via hobbyland's caddy, not through these ports.
BACKEND_PORT=8080
BACKEND_PORT_JAVA=59003

# PostgreSQL credentials (Spring backend).
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=xiangqi

# Redis password (Spring backend).
REDIS_PASSWORD=change-me-redis

# App-served TLS: the Java backend serves its own self-signed HTTPS
# (deploy/ensure-certs.sh provisions deploy/certs/{cert,key}.pem).
# Set to false only for local plain-HTTP A/B runs.
HTTPS=true

# Public domain served by the external reverse proxy (hobbyland's Caddyfile).
DOMAIN=chinese.jackstudio.app

# External docker network shared with hobbyland's caddy. When set, deploy.sh
# attaches xq_backend_java via docker-compose.external-proxy.yml so caddy can
# reach https://xiangqi-app:8080. Create once on the VPS:
#   docker network create shared-proxy
# Leave unset for local-only runs.
#EXTERNAL_PROXY_NET=shared-proxy
